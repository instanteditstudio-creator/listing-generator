.idea-card{background:#fff;border:1px solid #E8E0DA;border-radius:14px;padding:22px;margin-bottom:14px;}
.idea-header{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:12px;}
.idea-title{font-size:16px;font-weight:700;color:#1A1A1A;line-height:1.3;}
.idea-badge{font-size:11px;font-weight:600;padding:4px 12px;border-radius:99px;white-space:nowrap;flex-shrink:0;}
.badge-inv{background:#FDF5F3;color:#C45C5C;}
.badge-plan{background:#EFF4FB;color:#1E3A6E;}
.badge-art{background:#F5F0FA;color:#6B3FA0;}
.badge-seas{background:#FFF8E8;color:#8B6914;}
.badge-party{background:#EEF7F2;color:#2D6A4F;}
.idea-desc{font-size:13px;color:#777;line-height:1.6;margin-bottom:14px;}
.idea-meta{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;}
.meta-item{background:#FAF7F2;border-radius:10px;padding:10px 12px;}
.meta-label{font-size:10px;color:#AAA;text-transform:uppercase;letter-spacing:.06em;margin-bottom:3px;font-weight:600;}
.meta-value{font-size:13px;color:#1A1A1A;font-weight:600;}
.keywords-section{background:#fff;border:1px solid #E8E0DA;border-radius:14px;padding:22px;margin-bottom:14px;}
.keywords-title{font-size:15px;font-weight:700;margin-bottom:14px;color:#1A1A1A;}
.keywords-grid{display:flex;flex-wrap:wrap;gap:8px;}
.keyword-pill{padding:7px 16px;border-radius:99px;font-size:13px;font-weight:500;cursor:pointer;transition:all .15s;}
.keyword-pill.high{background:#C45C5C;color:white;}
.keyword-pill.med{background:#FDF5F3;color:#C45C5C;border:1px solid #F0DDD8;}
.keyword-pill.low{background:#FAF7F2;color:#888;border:1px solid #E8E0DA;}
.seasonal-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;}
.seasonal-card{background:#fff;border:1px solid #E8E0DA;border-radius:14px;padding:20px;border-left:5px solid;}
.seasonal-card h4{font-size:15px;font-weight:700;margin-bottom:6px;}
.seasonal-card p{font-size:13px;color:#777;line-height:1.6;margin-bottom:10px;}
.seasonal-days{font-size:12px;font-weight:600;color:#888;}
.alert-card{background:linear-gradient(135deg,#FDF5F3,#FAF7F2);border:1px solid #F0DDD8;border-radius:14px;padding:22px;margin-bottom:14px;display:flex;gap:16px;align-items:flex-start;}
.alert-icon{font-size:28px;flex-shrink:0;}
.alert-title{font-size:15px;font-weight:700;color:#C45C5C;margin-bottom:5px;}
.alert-desc{font-size:13px;color:#777;line-height:1.6;}
.empty-state{text-align:center;padding:60px 20px;color:#888;}
.empty-state .big-icon{font-size:56px;margin-bottom:16px;}
.empty-state h3{font-family:'Playfair Display',serif;font-size:22px;font-weight:700;color:#1A1A1A;margin-bottom:8px;}
.empty-state p{font-size:14px;line-height:1.7;max-width:380px;margin:0 auto;}
.results-wrap{display:none;}
.results-wrap.show{display:block;}
.refresh-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;padding:16px 20px;background:#fff;border:1px solid #E8E0DA;border-radius:12px;}
.refresh-info{font-size:13px;color:#888;}
.refresh-info strong{color:#1A1A1A;}
.refresh-btn{padding:9px 20px;background:#FAF7F2;border:1px solid #E8E0DA;border-radius:10px;font-size:13px;font-weight:600;color:#C45C5C;cursor:pointer;font-family:'DM Sans',sans-serif;}
.refresh-btn:hover{background:#FDF5F3;border-color:#C45C5C;}
.divider{height:1px;background:#E8E0DA;margin:32px 0;}
@media(max-width:640px){.trends-grid{grid-template-columns:1fr}.seasonal-grid{grid-template-columns:1fr}.idea-meta{grid-template-columns:1fr 1fr}}
</style>
