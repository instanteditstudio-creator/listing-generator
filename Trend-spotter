      {title:"Canva Editable Party Bundles",description:"Buyers love getting multiple matching items — invitation, menu, sign, favor tag all in one purchase.",heat:"hot",tags:["party bundle","editable","matching set"]},
      {title:"Motivational Wall Art Sets",description:"3-piece and 5-piece printable wall art sets outperform singles. Boho and neutral tones are leading.",heat:"rising",tags:["wall art","printable","gallery wall"]},
      {title:"Birthday Dinner Invitations",description:"Adult birthday dinner party invitations are underserved. Elegant, sophisticated designs sell well all year.",heat:"rising",tags:["birthday dinner","adult party","elegant invite"]}
    ],
    designIdeas:[
      {title:"Bridal Shower Invitation Bundle (5 pieces)",description:"Create a complete bridal shower set — invitation, details card, RSVP, thank you card, and welcome sign. Bundles command premium prices of $12-18 and get far more favorites than single items.",category:"invitation",demand:"High",competition:"Medium",suggestedPrice:"$12.99-$18.99",keywords:["bridal shower invitation","bridal shower bundle","editable bridal shower"]},
      {title:"Bachelorette Weekend Itinerary Template",description:"Weekend schedule, activity checklist, and packing list in a matching design set. This is one of the fastest growing categories on Etsy right now with searches up 40% year over year.",category:"party",demand:"High",competition:"Low",suggestedPrice:"$9.99-$14.99",keywords:["bachelorette itinerary","bach weekend","girls trip itinerary"]},
      {title:"Undated Weekly Planner — Boho Style",description:"Undated planners sell 3x longer than dated ones. A beautiful boho aesthetic weekly spread with habit tracker and notes section. Buyers purchase these year round.",category:"planner",demand:"High",competition:"Medium",suggestedPrice:"$7.99-$12.99",keywords:["weekly planner printable","undated planner","boho planner"]},
      {title:"Baby Shower Invitation — Neutral Modern",description:"Gender-neutral baby shower invitations in beige, sage, and warm neutrals are outperforming pink and blue. Modern minimalist style with clean typography.",category:"invitation",demand:"Growing",competition:"Medium",suggestedPrice:"$8.99-$12.99",keywords:["baby shower invitation","neutral baby shower","modern baby shower"]},
      {title:"Motivational Quote Wall Art Set (5 pieces)",description:"Curated sets of 5 matching motivational prints in neutral tones. Home office and bedroom decor is a top search category. Sets at 5x7 and 8x10 sizes included.",category:"wall art",demand:"High",competition:"Low",suggestedPrice:"$9.99-$14.99",keywords:["printable wall art","motivational prints","gallery wall set"]},
