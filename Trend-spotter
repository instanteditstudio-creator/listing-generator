.status-text{font-size:13px;color:#888;margin-top:8px;}
.section{margin-bottom:32px;}
.section-header{display:flex;align-items:center;gap:12px;margin-bottom:20px;}
.section-icon{font-size:24px;}
.section-title{font-family:'Playfair Display',serif;font-size:22px;font-weight:700;color:#1A1A1A;}
.section-sub{font-size:13px;color:#888;margin-top:2px;}
.trends-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;}
.trend-card{background:#fff;border:1px solid #E8E0DA;border-radius:14px;padding:20px;transition:all .2s;cursor:default;}
.trend-card:hover{box-shadow:0 4px 20px rgba(0,0,0,0.08);transform:translateY(-2px);}
.trend-card .heat{font-size:11px;font-weight:700;padding:3px 10px;border-radius:99px;display:inline-block;margin-bottom:10px;}
.heat.fire{background:#FFF0E8;color:#D4622A;}
