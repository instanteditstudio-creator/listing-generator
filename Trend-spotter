.progress-card{background:#fff;border:1px solid #E8E0DA;border-radius:16px;padding:24px;margin-bottom:24px;display:none;}
.progress-card.show{display:block;}
.pbar-wrap{background:#E8E0DA;border-radius:99px;height:6px;overflow:hidden;margin:12px 0;}
.pbar{height:100%;background:linear-gradient(90deg,#C45C5C,#E8856A);border-radius:99px;width:0%;transition:width .5s ease;}
.spin{display:inline-block;width:14px;height:14px;border:2px solid rgba(196,92,92,.25);border-top-color:#C45C5C;border-radius:50%;animation:sp .7s linear infinite;margin-right:8px;vertical-align:middle;}
