.date-badge{display:inline-block;background:#FDF5F3;border:1px solid #F0DDD8;border-radius:99px;padding:6px 16px;font-size:12px;color:#C45C5C;font-weight:600;margin-top:12px;letter-spacing:.04em;}
.scan-btn{display:block;width:100%;max-width:480px;margin:0 auto 36px;padding:17px;background:#C45C5C;color:#fff;border:none;border-radius:14px;font-family:'Playfair Display',serif;font-size:21px;font-style:italic;cursor:pointer;transition:all .2s;}
