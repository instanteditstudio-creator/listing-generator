.logo b{color:#E8856A;font-style:normal;}
.header-links{display:flex;gap:12px;}
.header-link{font-size:12px;color:#888;text-decoration:none;padding:6px 12px;border:1px solid #333;border-radius:8px;transition:all .2s;}
