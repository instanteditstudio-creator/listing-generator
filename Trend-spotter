<script>
// Date
var now=new Date();
var days=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
var months=['January','February','March','April','May','June','July','August','September','October','November','December'];
document.getElementById('dateBadge').textContent=days[now.getDay()]+', '+months[now.getMonth()]+' '+now.getDate()+', '+now.getFullYear();

var ANTHROPIC_KEY='';// Uses fetch via Anthropic API

function sleep(ms){return new Promise(function(r){setTimeout(r,ms);});}

async function setProgress(pct,text){
  document.getElementById('pbar').style.width=pct+'%';
  document.getElementById('statusText').textContent=text;
  await sleep(200);
}

document.getElementById('scanBtn').onclick=runScan;
document.getElementById('refreshBtn').onclick=runScan;

async function runScan(){
  document.getElementById('scanBtn').disabled=true;
  document.getElementById('progressCard').className='progress-card show';
  document.getElementById('emptyState').style.display='none';
  document.getElementById('resultsWrap').className='results-wrap';

  try{
    await setProgress(10,'Analyzing current Etsy digital download trends...');
    await setProgress(25,'Scanning seasonal opportunities and upcoming events...');
    await setProgress(40,'Generating design ideas for LoveyTemplatesCo...');
    await setProgress(60,'Pulling top keywords and search volume data...');
    await setProgress(75,'Building your personalized trend report...');

    var data=await fetchTrendData();

    await setProgress(90,'Formatting your report...');
    await sleep(400);
    await setProgress(100,'Done!');
    await sleep(300);

    renderResults(data);

    document.getElementById('progressCard').className='progress-card';
    document.getElementById('resultsWrap').className='results-wrap show';
    document.getElementById('lastScanned').textContent=new Date().toLocaleTimeString();
    document.getElementById('resultsWrap').scrollIntoView({behavior:'smooth'});

  }catch(e){
    console.error(e);
    // Use fallback data
    var fallback=getFallbackData();
    renderResults(fallback);
    document.getElementById('progressCard').className='progress-card';
    document.getElementById('resultsWrap').className='results-wrap show';
  }

  document.getElementById('scanBtn').disabled=false;
}

async function fetchTrendData(){
  var currentMonth=months[now.getMonth()];
  var currentYear=now.getFullYear();
  var nextMonth=months[(now.getMonth()+1)%12];

  var prompt='You are an expert Etsy seller and digital product trend analyst. Today is '+currentMonth+' '+now.getDate()+', '+currentYear+'. Generate a comprehensive real-time Etsy trend report for a shop called LoveyTemplatesCo that sells digital download templates including invitations, party printables, planners, journals, and wall art.\n\nReturn ONLY a valid JSON object with NO markdown, NO backticks, NO extra text. The JSON must have exactly this structure:\n{\n"hotTrends":[\n{"title":"trend name","description":"2 sentences about why this is trending","heat":"fire|hot|rising","tags":["tag1","tag2","tag3"]}\n],\n"designIdeas":[\n{"title":"specific template name to create","description":"2-3 sentences on why this will sell and who buys it","category":"invitation|planner|wall art|party|seasonal","demand":"High|Medium|Growing","competition":"Low|Medium|High","suggestedPrice":"$X.XX-$X.XX","keywords":["keyword1","keyword2","keyword3"]}\n],\n"keywords":{\n"high":["keyword1","keyword2","keyword3","keyword4","keyword5","keyword6"],\n"rising":["keyword1","keyword2","keyword3","keyword4","keyword5","keyword6"],\n"niche":["keyword1","keyword2","keyword3","keyword4","keyword5","keyword6"]\n},\n"seasonal":[\n{"event":"event name","daysAway":30,"urgency":"Create now|Start soon|Plan ahead","description":"what to create and why","color":"#hexcolor"}\n],\n"alerts":[\n{"title":"alert title","description":"specific action to take for LoveyTemplatesCo right now"}\n]\n}\n\nInclude:\n- 6 hot trends (mix of invitations, planners, wall art, party, seasonal)\n- 6 specific design ideas with real market insight\n- 18 keywords total (6 high, 6 rising, 6 niche)\n- 4 seasonal opportunities based on the current date '+currentMonth+' and upcoming month '+nextMonth+'\n- 3 urgent shop alerts specific to right now\n\nMake everything specific, actionable and based on real Etsy market trends for '+currentMonth+' '+currentYear+'.';

  var response=await fetch('https://api.anthropic.com/v1/messages',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({
      model:'claude-sonnet-4-20250514',
      max_tokens:4000,
      tools:[{type:'web_search_20250305',name:'web_search'}],
      messages:[{role:'user',content:prompt}]
    })
  });

  if(!response.ok)throw new Error('API error');
  var data=await response.json();

  // Extract text from response
  var text='';
  if(data.content){
    for(var i=0;i<data.content.length;i++){
      if(data.content[i].type==='text')text+=data.content[i].text;
    }
  }

  // Clean and parse JSON
  text=text.replace(/```json/g,'').replace(/```/g,'').trim();
  // Find JSON object
  var start=text.indexOf('{');var end=text.lastIndexOf('}');
  if(start>-1&&end>-1)text=text.substring(start,end+1);

  return JSON.parse(text);
}

