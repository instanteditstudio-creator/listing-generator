      {title:"Your pricing may be too high for new sellers",description:"At $9.99 you are in the premium tier for a new shop with 0 reviews. Consider launching your next 3 listings at $5.99-$7.99 to get your first sales and reviews, then raise prices. Social proof converts more than price."},
      {title:"Add a bundle listing immediately",description:"Bundle listings (3-5 matching templates together) consistently earn 2-3x more per transaction and get more organic favorites. Create a matching set from one of your existing designs."},
      {title:"Your listing titles need SEO keywords first",description:"Put your strongest keywords at the very start of your listing title. Example: 'Editable Birthday Invitation Canva Template, Dinner Party Invite, Printable' performs better than 'Talk Thirty To Me - Fun Birthday Invitation'."}
    ]
  };
}

function renderResults(data){
  // Hot trends
  var hotHtml='';
  (data.hotTrends||[]).forEach(function(t){
    var heatLabel=t.heat==='fire'?'On Fire':t.heat==='hot'?'Hot':'Rising';
    hotHtml+='<div class="trend-card"><span class="heat '+t.heat+'">'+heatLabel+'</span><h4>'+t.title+'</h4><p>'+t.description+'</p><div class="trend-tags">'+(t.tags||[]).map(function(tg){return '<span class="trend-tag">'+tg+'</span>';}).join('')+'</div></div>';
  });
  document.getElementById('hotGrid').innerHTML=hotHtml;

  // Design ideas
  var ideasHtml='';
  (data.designIdeas||[]).forEach(function(idea){
    var badgeClass={invitation:'badge-inv',planner:'badge-plan','wall art':'badge-art',seasonal:'badge-seas',party:'badge-party'}[idea.category]||'badge-inv';
    ideasHtml+='<div class="idea-card"><div class="idea-header"><div class="idea-title">'+idea.title+'</div><span class="idea-badge '+badgeClass+'">'+idea.category+'</span></div><div class="idea-desc">'+idea.description+'</div><div class="idea-meta"><div class="meta-item"><div class="meta-label">Demand</div><div class="meta-value">'+idea.demand+'</div></div><div class="meta-item"><div class="meta-label">Competition</div><div class="meta-value">'+idea.competition+'</div></div><div class="meta-item"><div class="meta-label">Suggested Price</div><div class="meta-value">'+idea.suggestedPrice+'</div></div></div>';
    if(idea.keywords&&idea.keywords.length){ideasHtml+='<div style="margin-top:12px;display:flex;flex-wrap:wrap;gap:5px;">'+(idea.keywords||[]).map(function(k){return '<span class="trend-tag">'+k+'</span>';}).join('')+'</div>';}
    ideasHtml+='</div>';
  });
  document.getElementById('ideasList').innerHTML=ideasHtml;

  // Keywords
  var kw=data.keywords||{};
  document.getElementById('highKeywords').innerHTML=(kw.high||[]).map(function(k){return '<span class="keyword-pill high">'+k+'</span>';}).join('');
  document.getElementById('medKeywords').innerHTML=(kw.rising||[]).map(function(k){return '<span class="keyword-pill med">'+k+'</span>';}).join('');
  document.getElementById('lowKeywords').innerHTML=(kw.niche||[]).map(function(k){return '<span class="keyword-pill low">'+k+'</span>';}).join('');

  // Seasonal
  var seasHtml='';
  (data.seasonal||[]).forEach(function(s){
    var urgColor=s.urgency==='Create now'?'#C45C5C':s.urgency==='Start soon'?'#D4622A':'#2D6A4F';
    seasHtml+='<div class="seasonal-card" style="border-left-color:'+s.color+'"><h4>'+s.event+'</h4><p>'+s.description+'</p><div class="seasonal-days" style="color:'+urgColor+'">'+s.urgency+' — '+s.daysAway+' days away</div></div>';
  });
  document.getElementById('seasonalGrid').innerHTML=seasHtml;

  // Alerts
  var alertsHtml='';
  var alertIcons=['⚡','💰','📈'];
  (data.alerts||[]).forEach(function(a,i){
    alertsHtml+='<div class="alert-card"><div class="alert-icon">'+alertIcons[i%3]+'</div><div><div class="alert-title">'+a.title+'</div><div class="alert-desc">'+a.description+'</div></div></div>';
  });
  document.getElementById('alertsList').innerHTML=alertsHtml;
}
</script>
</body>
</html>
