<style>
*{box-sizing:border-box;margin:0;padding:0;}
body{background:#FAF7F2;font-family:'DM Sans',sans-serif;color:#1A1A1A;min-height:100vh;}
header{background:#1A1A1A;padding:16px 32px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;}
